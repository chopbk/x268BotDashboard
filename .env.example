MONGODB=mongodb://localhost:27017/myapp
WEB_PORT=4000
WEB_HOST=
WEB_JWT_SECRET=change-me-to-a-long-random-string
WEB_ADMIN_EMAIL=admin@example.com
WEB_ADMIN_PASSWORD=change-me-min-8
CLIENT_ORIGIN=http://localhost:5173
REDIS_URL=
WEB_TRUST_PROXY=false
# Peer tinyproxy — public GET fapi (klines/premium/ticker). SIGNED vẫn direct.
# Để trống BINANCE_PEER_PROXIES thì hydrate từ Mongo peer_proxy_config (panel /system).
# BINANCE_PEER_PROXIES=http://botpeer:pass@45.32.252.50:13128,http://botpeer:pass@45.76.149.189:13128
# BINANCE_PEER_PROXY_SELF_IP=
# MQTT bridge tới binance-bot (đọc mqtt_configs theo MQTT env, hoặc ghi đè URL)
MQTT=
WEB_MQTT_ENV=
WEB_MQTT_URL=
# Dashboard tổng quan: cache memory (ms), ngưỡng attention
DASHBOARD_CACHE_MS=30000
DASHBOARD_WALLET_ATTENTION_MIN=-5
DASHBOARD_WALLET_CRITICAL=-50
DASHBOARD_SIGNAL_ATTENTION_MIN=-5
DASHBOARD_UPNL_CRITICAL=-100
# Smart Money collector (snapshot chung cho /smart-money, Terminal dòng tiền, AI)
# SMART_MONEY_ENABLED=true
# SMART_MONEY_SYMBOLS=BTCUSDT,ETHUSDT
# SMART_MONEY_TOP_N=10
# SMART_MONEY_MAX_SYMBOLS=30
# SMART_MONEY_RETENTION_DAYS=90
# SMART_MONEY_SM_GAP_MS=13000
