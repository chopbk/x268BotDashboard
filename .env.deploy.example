# Copy: cp .env.deploy.example .env.deploy
# File này không commit (.gitignore)
#
# Dùng từ máy local sau khi push: npm run deploy:remote
# → SSH vào server → cd DEPLOY_DIR → npm run update (pull + deploy + PM2)

# SSH: user@host (một máy đủ cho web-bot; nhiều máy cách nhau bằng dấu phẩy)
DEPLOY_SSH=chopbk@45.32.252.50

# Thư mục checkout repo trên server (không phải /var/www/web-bot static)
DEPLOY_DIR=/home/chopbk/web-bot
